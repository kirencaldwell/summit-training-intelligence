# Copy this file to .env and fill in your values
# .env is gitignored — never commit real keys

# Server-side only (no VITE_ prefix = never exposed to browser)
GEMINI_API_KEY=
# Optional: main coach model (default gemini-3.5-flash)
GEMINI_MODEL=
# Optional: cheaper model that filters the athlete data before the coach sees it (default gemini-3.5-flash-lite)
GEMINI_FILTER_MODEL=

# Client-side Supabase (safe to expose — anon key has row-level security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
